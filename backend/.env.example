PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mk_paper_mill
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT — generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_secure_64_char_random_string
JWT_EXPIRES_IN=8h

# Phase B: comma-separated allowed origins (production only). e.g. https://erp.mkpapermill.com
CORS_ORIGIN=

# Kafka (optional telemetry streaming stack)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092

